<?xml version="1.0" encoding="utf-8"?>
<!-- WMP 12's black glass control bar: a dark gradient with a bright top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#FF3B3E43" android:centerColor="#FF15171A" android:endColor="#FF0A0B0D" />
            <stroke android:width="1dp" android:color="#FF000000" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:height="20dp" android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="9dp" android:topRightRadius="9dp" />
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" android:type="linear" />
        </shape>
    </item>
</layer-list>
