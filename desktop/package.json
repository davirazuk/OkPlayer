{
  "name": "okplayer",
  "productName": "okplayer",
  "version": "0.5.0",
  "description": "Local music player in the style of Windows Media Player 12",
  "author": "davirazuk",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "sync-web": "node -e \"require('fs').cpSync('../web', 'web', {recursive: true})\"",
    "start": "npm run sync-web && electron .",
    "dist": "npm run sync-web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.davirazuk.okplayer",
    "productName": "okplayer",
    "artifactName": "okplayer-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "thumbar/*.png"
    ],
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "publish": null
  },
  "repository": "https://github.com/davirazuk/OkPlayer"
}
